# JSON list or comma-separated string. Only these exact strings can log in.
MK4_ALLOWED_LOGIN_IDS=["owner-secret-id","family-demo-id","friend-demo-id"]
MK4_OWNER_LOGIN_ID=owner-secret-id
MK4_OWNER_GRAPH_USER_ID=existing-graph-user-id
MK4_MAX_ACTIVE_SESSIONS=3
MK4_SESSION_TTL_HOURS=168
MK4_SESSION_COOKIE_SECURE=false
# Optional: MK4_SESSIONS_DB_PATH=C:\path\to\sessions.db

# Global safety cap for model/tool rounds inside one user request.
MK4_AGENT_MAX_ROUNDS=40

# Optional local continuous voice mode.
# Install with: pip install -r MK4/requirements.txt
# STT uses faster-whisper directly in the MK4 Python process.
# For fully offline use, point MK4_STT_MODEL at an already-downloaded local
# CTranslate2 Whisper model directory. A model name such as "small" may trigger
# a first-time download if it is not already cached.
MK4_STT_MODEL=
MK4_STT_DEVICE=cpu
MK4_STT_COMPUTE_TYPE=int8
MK4_STT_LANGUAGE=ko
MK4_STT_BEAM_SIZE=1
MK4_STT_CPU_THREADS=4

# TTS uses piper-tts directly in the MK4 Python process.
# Point to an already-downloaded Piper .onnx voice model. Its matching .json
# config is normally discovered next to the model; set MK4_TTS_CONFIG_PATH only
# when it lives elsewhere.
MK4_TTS_MODEL_PATH=
MK4_TTS_CONFIG_PATH=
# Optional multi-speaker / voice tuning settings:
MK4_TTS_SPEAKER_ID=
MK4_TTS_LENGTH_SCALE=
MK4_TTS_SENTENCE_SILENCE=

MK4_VOICE_INFERENCE_TIMEOUT_SECONDS=120
MK4_VOICE_MAX_AUDIO_BYTES=12582912
MK4_VOICE_MAX_TTS_CHARS=6000
