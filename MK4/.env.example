# JSON list or comma-separated string. Only these exact strings can log in.
MK4_ALLOWED_LOGIN_IDS=["owner-secret-id","family-demo-id","friend-demo-id"]
MK4_OWNER_LOGIN_ID=owner-secret-id
MK4_OWNER_GRAPH_USER_ID=existing-graph-user-id
MK4_MAX_ACTIVE_SESSIONS=3
MK4_SESSION_TTL_HOURS=168
MK4_SESSION_COOKIE_SECURE=false
# Optional: MK4_SESSIONS_DB_PATH=C:\path\to\sessions.db

# Global safety cap for model/tool rounds inside one user request.
MK4_AGENT_MAX_ROUNDS=40

# Optional local continuous voice mode.
# No cloud STT/TTS API is built into MK4. Both commands run locally.
# STT receives a 16 kHz mono WAV path in {input} and should print only the
# transcription to stdout. If {output} is present, it may instead write UTF-8
# transcription text to that exact path.
# Example using your own local wrapper:
# MK4_STT_COMMAND=python C:\local-voice\stt.py --input {input}
#
# TTS receives the assistant text as UTF-8 stdin and must write WAV to {output}.
# Piper example (when piper and the voice model are already installed locally):
# MK4_TTS_COMMAND=piper --model C:\local-voice\ko_KR-voice.onnx --output_file {output}
#
# Voice mode remains disabled in the UI until both commands are configured.
MK4_STT_COMMAND=
MK4_TTS_COMMAND=
MK4_VOICE_COMMAND_TIMEOUT_SECONDS=120
MK4_VOICE_MAX_AUDIO_BYTES=12582912
MK4_VOICE_MAX_TTS_CHARS=6000
