# JSON list or comma-separated string. Only these exact strings can log in.
MK4_ALLOWED_LOGIN_IDS=["owner-secret-id","family-demo-id","friend-demo-id"]
MK4_OWNER_LOGIN_ID=owner-secret-id
MK4_OWNER_GRAPH_USER_ID=existing-graph-user-id
MK4_MAX_ACTIVE_SESSIONS=3
MK4_SESSION_TTL_HOURS=168
MK4_SESSION_COOKIE_SECURE=false
# Optional: MK4_SESSIONS_DB_PATH=C:\path\to\sessions.db

# Default local models.
# The chat model is the initial selection shown in the UI. The image model is
# server-managed only and is not user-selectable from the browser.
MK4_OLLAMA_MODEL_NAME=qwen3.5:9b
MK4_OLLAMA_IMAGE_MODEL_NAME=gemma4:12b
MK4_OLLAMA_IMAGE_FALLBACK_MODEL_NAME=gemma4:12b

# Global safety cap for model/tool rounds inside one user request.
MK4_AGENT_MAX_ROUNDS=40

# Local continuous voice mode.
# Set false to hide the microphone button and hard-disable voice preparation,
# STT and TTS endpoints. This prevents model download/load/inference entirely.
MK4_VOICE_ENABLED=true
# Install Python dependencies with: pip install -r MK4/requirements.txt
#
# Defaults require no model-path configuration. On first voice use MK4 downloads
# missing assets into MK4/data/voice_models and reuses them afterwards.
MK4_VOICE_AUTO_DOWNLOAD=true
# Optional custom cache location:
# MK4_VOICE_MODEL_DIR=C:\path\to\voice_models

# STT default: multilingual faster-whisper small.
# Other useful choices include base, medium, large-v3 and turbo/large-v3-turbo
# when supported by the installed faster-whisper release. A local CTranslate2
# directory can also be supplied here to prevent any STT download.
MK4_STT_MODEL=small
MK4_STT_DEVICE=cpu
MK4_STT_COMPUTE_TYPE=int8
MK4_STT_LANGUAGE=ko
MK4_STT_BEAM_SIZE=1
MK4_STT_CPU_THREADS=4

# TTS default: Apache-2.0 Qwen3-TTS 12Hz 0.6B CustomVoice + Sohee.
# The first download is roughly 2.5 GB. Sohee is the native Korean preset.
MK4_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice
MK4_TTS_SPEAKER=Sohee
MK4_TTS_LANGUAGE=Korean
MK4_TTS_INSTRUCT=차분하고 안정적인 말투로 자연스럽게 말해줘.

# Hardware defaults. "auto" uses CUDA when PyTorch reports CUDA support,
# otherwise it safely falls back to CPU/float32. AMD GPU acceleration on Windows
# depends on the installed PyTorch/runtime and is not assumed here.
MK4_TTS_DEVICE=auto
MK4_TTS_DTYPE=auto

# Optional pre-downloaded/custom Qwen3-TTS model directory. When set, this local
# directory wins over MK4_TTS_MODEL and no managed TTS download is performed.
MK4_TTS_MODEL_PATH=

# First-run model download can take much longer than normal inference.
MK4_VOICE_PREPARE_TIMEOUT_SECONDS=1800
MK4_VOICE_INFERENCE_TIMEOUT_SECONDS=300
MK4_VOICE_MAX_AUDIO_BYTES=12582912
MK4_VOICE_MAX_TTS_CHARS=6000
